# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: App Configuration
NEXT_PUBLIC_APP_NAME=Self Aura Management
NEXT_PUBLIC_APP_VERSION=1.0.0

# Cloudinary cloud name for the deployment whose media this dashboard manages.
#
# This is the ONLY Cloudinary value a browser ever needs, and it is public: it
# already appears in every delivery URL. The API key and the API secret are
# server-side only - they live in the backend's .env and must never be copied
# here, into any NEXT_PUBLIC_ variable, or into this file's real values.
#
# It is used by next.config.ts to build a NARROW remotePatterns allow-list:
# https://res.cloudinary.com/<cloud>/image/upload/** and .../video/upload/**.
# A wildcard host is deliberately not used. Leave it unset and the dashboard
# falls back to unoptimised delivery for Cloudinary images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Extra trusted image origins for next/image, comma-separated, e.g.
#   https://media.selfaura.com
# The API origin (from NEXT_PUBLIC_API_URL) is always allowed, which is what
# serves product records written by the previous local-filesystem adapter at
# /media/<key>. This list is only needed if media is ever fronted on a different
# host. It is an ALLOW-LIST - wildcards are not supported on purpose.
NEXT_PUBLIC_MEDIA_HOSTS=
